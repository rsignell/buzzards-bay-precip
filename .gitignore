.ipynb_checkpoints/
.jupyter_ystore.db
.claude/
__pycache__/

# Re-fetchable IIPP raster cache; pull_forest_hosts.py rebuilds it.
forest/*.tif
# ~10 MB of base64-embedded rasters; make_forest_map.py rebuilds it.
forest/*.html
# Large S2 rasters live on the oak-mapping cluster; s2_deciduous.py rebuilds them.
s2/*.tif
# Rasterised from Soil Data Access; pull_soil.py rebuilds them.
soil/*.tif

# Per-species score rasters; score_species.py rebuilds them.
scores/*.tif
# Moisture state; mrms_moisture.py rebuilds it.
moisture/*.tif
# The app itself; make_foraging_app.py rebuilds it.
app/*.html

# Derived outputs at the repo root -- tables, figures and interactive maps that
# the scripts above rebuild from the CoCoRaHS API, MRMS and HRRR. Regenerating
# a day's worth is a couple of minutes, so they are not worth versioning; the
# interactive maps in particular are ~1 MB of base64-embedded tiles each.
# Scoped to the root on purpose: forest/ and s2/ products stay tracked, since
# rebuilding those needs the oak-mapping cluster.
/*.csv
/*.png
/*.html
